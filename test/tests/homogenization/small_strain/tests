[Tests]
  [homogeneous_kinematic]
    type = CSVDiff
    input = homogeneous_kinematic.i
    cli_args = 'Outputs/exodus=false'
    csvdiff = homogeneous_kinematic_out.csv
    requirement = 'The application shall recover the exact homogeneous plane-strain response using its framework-only AD small-strain homogenization implementation.'
  []
  [homogeneous_mixed]
    type = CSVDiff
    input = homogeneous_kinematic.i
    cli_args = "GlobalParams/constraint_types='strain none none stress stress none none none none' Outputs/exodus=false Outputs/file_base=homogeneous_mixed_out"
    csvdiff = homogeneous_mixed_out.csv
    requirement = 'The application shall enforce one average-strain and two average-stress constraints in a homogeneous plane-strain SVE.'
  []
  [homogeneous_static]
    type = CSVDiff
    input = homogeneous_kinematic.i
    cli_args = "GlobalParams/constraint_types='stress none none stress stress none none none none' Functions/target_xx/expression=1 Outputs/exodus=false Outputs/file_base=homogeneous_static_out"
    csvdiff = homogeneous_static_out.csv
    requirement = 'The application shall enforce three average-stress constraints in a homogeneous plane-strain SVE.'
  []
  [duplicate_symmetric_constraint]
    type = RunException
    input = homogeneous_kinematic.i
    cli_args = "GlobalParams/constraint_types='strain strain none strain strain none none none none' GlobalParams/targets='target_xx target_xy target_xy target_yy' Variables/macro_strain/order=FOURTH"
    expect_err = 'cannot both be constrained because strain and stress are symmetric'
    requirement = 'The application shall reject duplicate macroscopic unknowns for symmetric off-diagonal tensor components.'
  []
  [heterogeneous_anisotropic]
    type = CSVDiff
    input = heterogeneous_anisotropic.i
    cli_args = 'Outputs/exodus=false'
    csvdiff = heterogeneous_anisotropic_out.csv
    requirement = 'The application shall homogenize a heterogeneous anisotropic SVE with normal-shear coupling.'
  []
  [heterogeneous_anisotropic_jacobian]
    type = PetscJacobianTester
    input = heterogeneous_anisotropic.i
    run_sim = true
    ratio_tol = 1e-7
    difference_tol = 1e-5
    cli_args = 'Outputs/csv=false Outputs/exodus=false'
    requirement = 'The heterogeneous anisotropic homogenization system shall provide a consistent field-scalar Jacobian.'
  []
  [nonsymmetric_stiffness]
    type = RunException
    input = heterogeneous_anisotropic.i
    cli_args = "Materials/matrix/fill_method=antisymmetric Materials/matrix/C_ijkl='1 1 1 1 1 1'"
    expect_err = 'The elasticity tensor must have minor and major symmetry'
    requirement = 'The linear-elastic material shall reject a stiffness tensor without elastic symmetry.'
  []
  [unstable_stiffness]
    type = RunException
    input = heterogeneous_anisotropic.i
    cli_args = "Materials/matrix/C_ijkl='200 50 40 0 0 12 120 30 0 0 -8 150 0 0 0 45 10 0 70 0 -60'"
    expect_err = 'The symmetric elasticity tensor must be positive definite'
    requirement = 'The linear-elastic material shall reject a symmetric but unstable stiffness tensor.'
  []
  [invalid_scalar_owner_zero]
    type = RunException
    input = homogeneous_kinematic.i
    cli_args = 'Kernels/equilibrium_x/compute_scalar_residuals=false'
    expect_err = 'Only the component-zero kernel may assemble the macroscopic scalar equations'
    requirement = 'The component-zero homogenization kernel shall be required to own the macroscopic scalar equations.'
  []
  [invalid_scalar_owner_nonzero]
    type = RunException
    input = homogeneous_kinematic.i
    cli_args = 'Kernels/equilibrium_y/compute_scalar_residuals=true'
    expect_err = 'Only the component-zero kernel may assemble the macroscopic scalar equations'
    requirement = 'A nonzero-component homogenization kernel shall not assemble duplicate macroscopic scalar equations.'
  []
  [homogeneous_3d_xx]
    type = CSVDiff
    input = homogeneous_3d.i
